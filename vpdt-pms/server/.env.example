# .env.example — copy thành .env rồi điền giá trị thật (KHÔNG commit file .env lên Git)

PORT=3000

# --- Kết nối SQL Server ---
DB_SERVER=localhost          # hoặc IP máy chủ SQL Server nếu chạy riêng
DB_PORT=1433
DB_NAME=VPDT_DMS
DB_USER=sa
DB_PASSWORD=Your_Strong_Password_Here
DB_ENCRYPT=false
DB_TRUST_CERT=true

# --- Gửi email thật (SMTP) ---
# Host/Port/Email người gửi hiển thị trong màn Quản trị > Cấu Hình Email vẫn chỉnh được ở đó.
# Chỉ SMTP_HOST là bắt buộc đặt ở đây để bật gửi thật; SMTP_USER/SMTP_PASS là TÙY CHỌN (bỏ trống nếu
# mail relay nội bộ không yêu cầu xác thực, ví dụ chỉ cho phép kết nối từ IP nội bộ tin cậy). Không
# đặt tài khoản/mật khẩu SMTP trong ứng dụng vì GET /api/data trả nguyên dữ liệu cho mọi client.
#
# Ví dụ 1 — Gmail (cần xác thực): bật xác thực 2 bước cho tài khoản Gmail, tạo "Mật khẩu ứng dụng"
# (App Password) tại https://myaccount.google.com/apppasswords rồi dùng mật khẩu đó cho SMTP_PASS
# (không dùng mật khẩu Gmail thường vì Google đã chặn đăng nhập SMTP bằng mật khẩu thường).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false            # false cho port 587 (STARTTLS), true cho port 465 (TLS ngay từ đầu)
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=your-email@gmail.com   # để trống thì dùng luôn SMTP_USER (hoặc Email người gửi ở Quản trị)

# Ví dụ 2 — mail relay nội bộ KHÔNG cần xác thực: chỉ cần SMTP_HOST/SMTP_PORT/SMTP_FROM, để trống
# SMTP_USER và SMTP_PASS. Nếu relay dùng chứng chỉ TLS tự ký (self-signed), thêm dòng cuối:
# SMTP_HOST=mail.noidobo.local
# SMTP_PORT=25
# SMTP_FROM=vpdt-noreply@congty.vn
# SMTP_TLS_REJECT_UNAUTHORIZED=false
