# .env.example — copy thành .env rồi điền giá trị thật (KHÔNG commit file .env lên Git)

PORT=3000

# --- Kết nối SQL Server ---
DB_SERVER=localhost          # hoặc IP máy chủ SQL Server nếu chạy riêng
DB_PORT=1433
DB_NAME=VPDT_DMS
DB_USER=sa
DB_PASSWORD=Your_Strong_Password_Here
DB_ENCRYPT=false
DB_TRUST_CERT=true

# --- Gửi email thật (SMTP) ---
# Host/Port/Mã hoá TLS/Email người gửi/Bật-tắt: KHÔNG khai báo ở đây nữa — cấu hình DUY NHẤT trong
# màn Quản trị > Cấu Hình Email trên web (không nhạy cảm, admin đổi trực tiếp, không cần sửa .env hay
# khởi động lại server). File .env này CHỈ còn giữ tài khoản/mật khẩu đăng nhập SMTP thật — vì GET
# /api/data trả nguyên dữ liệu ứng dụng cho mọi client gọi được, không thể lưu mật khẩu ở đó.
#
# SMTP_USER/SMTP_PASS là TÙY CHỌN — để trống CẢ HAI nếu máy chủ SMTP không yêu cầu xác thực (ví dụ
# mail relay nội bộ chỉ cho phép kết nối từ IP tin cậy); điền cả hai nếu máy chủ SMTP yêu cầu đăng
# nhập. Màn Cấu Hình Email trên web sẽ hiển thị server đang ở chế độ nào (không lộ giá trị thật).
#
# Ví dụ 1 — Gmail (cần xác thực): bật xác thực 2 bước cho tài khoản Gmail, tạo "Mật khẩu ứng dụng"
# (App Password) tại https://myaccount.google.com/apppasswords rồi dùng mật khẩu đó cho SMTP_PASS
# (không dùng mật khẩu Gmail thường vì Google đã chặn đăng nhập SMTP bằng mật khẩu thường).
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Ví dụ 2 — mail relay nội bộ KHÔNG cần xác thực: để trống SMTP_USER và SMTP_PASS ở trên. Nếu relay
# dùng chứng chỉ TLS tự ký (self-signed), thêm dòng:
# SMTP_TLS_REJECT_UNAUTHORIZED=false
