# .env.example — copy thành .env rồi điền giá trị thật (KHÔNG commit file .env lên Git)

PORT=3000

# Chỉ đặt khi server chạy SAU 1 lớp reverse proxy thật (ví dụ Nginx theo hướng dẫn deploy) — cần thiết
# để rate-limit/khoá tài khoản đăng nhập sai nhiều lần nhận đúng IP thật của người dùng thay vì IP của
# Nginx. KHÔNG đặt nếu server chạy trực tiếp không qua proxy nào — bật sai sẽ để lộ chỗ giả mạo IP.
# TRUST_PROXY=1

# Danh sách domain KHÁC được phép gọi API này bằng JS trình duyệt (CORS), phân tách bằng dấu phẩy —
# chỉ cần đặt nếu có 1 frontend chạy ở domain khác domain của server này (hiện tại KHÔNG cần, vì
# frontend được chính server này phục vụ luôn, cùng domain). Để trống thì chỉ same-origin được phép —
# an toàn nhất, giữ nguyên nếu không chắc chắn.
# ALLOWED_ORIGINS=https://vpdt.example.com,https://vpdt-staging.example.com

# Domain công khai thật của server — CHỈ dùng để dựng link trong mã QR "làm bài test lớp offline"
# (routes/trainingRoster.js GET /api/training/class-qr/:classId), vì QR phải quét được từ điện thoại
# (không thể suy ra domain thật từ localhost). Để trống thì tự suy ra từ header Host của mỗi request —
# đủ dùng trong hầu hết trường hợp (kể cả sau Nginx, nếu đã bật TRUST_PROXY ở trên); chỉ cần đặt tay khi
# suy ra tự động bị sai (vd nhiều tầng proxy/CDN không chuyển tiếp đúng header Host gốc).
# APP_BASE_URL=https://vpdt.example.com

# --- Xác thực đăng nhập (bắt buộc phải đặt, server sẽ không khởi động nếu thiếu) ---
# Khoá bí mật dùng để ký/kiểm tra JWT phiên đăng nhập — PHẢI là chuỗi ngẫu nhiên dài, giữ kín, và
# KHÁC NHAU giữa các môi trường (dev/staging/production). Tạo nhanh bằng lệnh:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Đổi JWT_SECRET sẽ khiến MỌI phiên đăng nhập đang có bị đăng xuất (không sao, chỉ cần đăng nhập lại).
JWT_SECRET=change-me-to-a-long-random-string

# Cookie phiên đăng nhập mặc định bắt buộc HTTPS (Secure). Chỉ đặt =false khi chạy dev cục bộ qua
# http://localhost (KHÔNG bao giờ đặt false khi đã public ra Internet — cookie sẽ đi dạng cleartext).
COOKIE_SECURE=true

# Giới hạn số lần gọi POST /api/auth/login (đăng nhập/xác thực lại mật khẩu) từ 1 địa chỉ IP trong
# 15 phút — chỉ tính các lần THẤT BẠI, không tính lần thành công (xem routes/auth.js). Mặc định 2000,
# đủ cho cả công ty vài trăm người dùng chung 1 IP (văn phòng qua 1 NAT/proxy) cùng đăng nhập dồn dập
# mà không tự khoá nhau — lớp chống dò mật khẩu THẬT SỰ là khoá theo TÀI KHOẢN sau 5 lần sai liên tiếp
# (lib/loginAttempts.js, không phụ thuộc IP). Chỉ hạ xuống nếu chắc chắn không có nhiều người dùng chung
# 1 IP trong hệ thống của bạn.
# LOGIN_RATE_LIMIT_MAX=2000

# --- Kết nối SQL Server ---
DB_SERVER=localhost          # hoặc IP máy chủ SQL Server nếu chạy riêng
DB_PORT=1433
DB_NAME=VPDT_DMS
DB_USER=sa
DB_PASSWORD=Your_Strong_Password_Here
# DB_ENCRYPT=false hiện chỉ chấp nhận được khi SQL Server & server ứng dụng cùng nằm trong 1 phân đoạn
# mạng tin cậy duy nhất (không đi qua firewall/router trung gian nào, kể cả nội bộ) — server sẽ in cảnh
# báo lúc khởi động nếu vẫn để false. Đổi thành true NGAY KHI kiến trúc có server DB/app tách riêng (khác
# máy, khác VLAN, đi qua firewall dù vẫn trong mạng công ty) — xem hướng dẫn bật (không cần cài thêm
# chứng chỉ gì, SQL Server đã tự có sẵn self-signed cert) tại HUONG_DAN_DEPLOY_UBUNTU.md mục 10.4.
DB_ENCRYPT=false
DB_TRUST_CERT=true

# Connection pool — tinh chỉnh khi cần theo tải thực tế và cấu hình SQL Server. Không bắt buộc, để
# trống sẽ dùng giá trị mặc định trong ngoặc.
# DB_POOL_MAX=20                    # số kết nối tối đa trong pool (mặc định 20)
# DB_POOL_MIN=2                     # số kết nối giữ sẵn, tránh cold-start (mặc định 2)
# DB_POOL_IDLE_TIMEOUT_MS=30000     # đóng kết nối rảnh sau bao lâu (mặc định 30000)
# DB_POOL_ACQUIRE_TIMEOUT_MS=15000  # chờ tối đa để có kết nối rảnh trước khi báo lỗi (mặc định 15000)
# DB_REQUEST_TIMEOUT_MS=15000       # timeout cho mỗi câu lệnh SQL (mặc định 15000)
# DB_CONNECTION_TIMEOUT_MS=15000    # timeout khi thiết lập kết nối mới (mặc định 15000)

# Cache ngắn hạn trong bộ nhớ cho các lượt đọc AppData lặp lại nhiều (hiện dùng cho requireAuth() tra
# trạng thái tài khoản ở mỗi request có xác thực — xem lib/appData.js). Giảm tải DB đáng kể khi nhiều
# người dùng đồng thời, đổi lại thay đổi quyền/vô hiệu hoá tài khoản có thể trễ tối đa ngần này (mili
# giây) mới có hiệu lực ở các tiến trình KHÁC tiến trình vừa ghi (không ảnh hưởng nếu chỉ chạy 1 tiến
# trình — xem mục 9a HUONG_DAN_DEPLOY_UBUNTU.md). Đặt 0 để tắt hẳn cache này.
# APPDATA_CACHE_TTL_MS=3000

# --- Gửi email thật (SMTP) ---
# Host/Port/Kiểu mã hoá/Email người gửi/Bật-tắt/Tài khoản đăng nhập SMTP: cấu hình DUY NHẤT trong màn
# Quản trị > Cấu Hình Email trên web — không cần đụng .env hay khởi động lại server, kể cả tài khoản/
# mật khẩu SMTP (mã hoá 2 chiều trước khi lưu vào CSDL, xem lib/emailCrypto.js).
#
# Khoá dùng để mã hoá mật khẩu SMTP lưu trong CSDL — BẮT BUỘC đặt trước khi cấu hình mật khẩu SMTP qua
# web (bỏ trống vẫn chạy bình thường nếu bạn chỉ dùng SMTP_USER/SMTP_PASS bên dưới, hoặc máy chủ SMTP
# không yêu cầu xác thực). Tạo nhanh bằng lệnh:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Đổi giá trị này sau khi đã lưu mật khẩu SMTP qua web sẽ khiến server KHÔNG giải mã lại được mật khẩu
# đó nữa (tự động rơi về đường lùi SMTP_USER/SMTP_PASS bên dưới nếu có, hoặc coi như chưa cấu hình
# tài khoản) — cần vào lại màn Cấu Hình Email nhập lại mật khẩu SMTP sau khi đổi khoá này.
EMAIL_ENCRYPTION_KEY=change-me-to-a-long-random-string

# SMTP_USER/SMTP_PASS: ĐƯỜNG LÙI cho máy chủ đã deploy từ trước (chưa cấu hình tài khoản SMTP qua web ở
# trên) — KHÔNG BẮT BUỘC nữa, chỉ dùng khi màn Cấu Hình Email chưa lưu tài khoản nào. Để trống CẢ HAI
# nếu máy chủ SMTP không yêu cầu xác thực (ví dụ mail relay nội bộ chỉ cho phép kết nối từ IP tin cậy).
#
# Ví dụ — Gmail (cần xác thực): bật xác thực 2 bước cho tài khoản Gmail, tạo "Mật khẩu ứng dụng"
# (App Password) tại https://myaccount.google.com/apppasswords rồi dùng mật khẩu đó cho SMTP_PASS
# (không dùng mật khẩu Gmail thường vì Google đã chặn đăng nhập SMTP bằng mật khẩu thường).
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password

# Máy chủ SMTP dùng chứng chỉ TLS tự ký (self-signed) — bỏ qua kiểm tra hợp lệ chứng chỉ:
# SMTP_TLS_REJECT_UNAUTHORIZED=false

# --- CAPTCHA chống bot ở trang đăng nhập ---
# KHÔNG BẮT BUỘC, mặc định tắt (false) — trang đăng nhập không hiện CAPTCHA, hành vi giữ nguyên như
# trước. Nên bật khi hệ thống mở ra Internet công khai (không giới hạn qua VPN/whitelist IP). Tự vẽ +
# tự xác minh HOÀN TOÀN trên server (server/lib/captcha.js) — không cần tài khoản/API key của bên thứ
# 3 nào, chỉ cần đổi true rồi restart. Xem HUONG_DAN_DEPLOY_UBUNTU.md mục 10.5.
CAPTCHA_ENABLED=false
